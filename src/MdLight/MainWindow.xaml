<Window x:Class="MdLight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MdLight" Width="960" Height="700" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel x:Name="Root" Background="#FFF7F7F8">
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Height="58" Background="White"
                BorderBrush="#FFE5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="31" Height="31" CornerRadius="7" Background="#FF2563EB">
                        <TextBlock Text="M↓" Foreground="White" FontFamily="Segoe UI Semibold"
                                   FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppTitle" Text="MdLight" FontFamily="Segoe UI Semibold"
                                   FontSize="15" Foreground="#FF111827" />
                        <TextBlock x:Name="FileCaption" Text="Перетащите сюда Markdown-файл"
                                   FontSize="11" Foreground="#FF6B7280" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Content="Тёмная тема" Click="ThemeButton_Click"
                            Background="Transparent" BorderBrush="#FFD1D5DB" Foreground="#FF374151" />
                    <Button Content="Открыть…" Click="OpenButton_Click"
                            Background="#FF2563EB" BorderBrush="#FF2563EB" Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Height="28" Background="White"
                BorderBrush="#FFE5E7EB" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <TextBlock x:Name="StatusText" Text="Готово" FontSize="11" Foreground="#FF6B7280"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="Ctrl+O — открыть  ·  F5 — обновить" FontSize="11" Foreground="#FF9CA3AF"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Grid>
            <RichTextBox x:Name="Viewer" IsReadOnly="True" IsDocumentEnabled="True"
                         Background="Transparent" BorderThickness="0" Padding="42,26,42,50"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Visibility="Collapsed" SelectionBrush="#663B82F6" />
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="430" Margin="30">
                <TextBlock Text="MD" FontFamily="Segoe UI Light" FontSize="54" Foreground="#FF2563EB"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Простой просмотр Markdown" FontFamily="Segoe UI Semibold" FontSize="22"
                           Foreground="#FF111827" HorizontalAlignment="Center" Margin="0,12,0,7" />
                <TextBlock Text="Перетащите .md-файл в это окно или нажмите «Открыть…»."
                           FontSize="14" Foreground="#FF6B7280" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
