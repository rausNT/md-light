<Window x:Class="MdLight.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MdLight" Width="1160" Height="700" MinWidth="820" MinHeight="400"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewTextInput="Window_PreviewTextInput" Closing="Window_Closing">
    <DockPanel x:Name="Root" Background="#FFF7F7F8">
        <Border x:Name="Toolbar" DockPanel.Dock="Top" Height="58" Background="White"
                BorderBrush="#FFE5E7EB" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="31" Height="31" CornerRadius="7" Background="#FF2563EB">
                        <TextBlock Text="M↓" Foreground="White" FontFamily="Segoe UI Semibold"
                                   FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="AppTitle" Text="MdLight" FontFamily="Segoe UI Semibold"
                                   FontSize="15" Foreground="#FF111827" />
                        <TextBlock x:Name="FileCaption" Text="Drop a Markdown file here"
                                   FontSize="11" Foreground="#FF6B7280" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NewButton" Content="New" Click="NewButton_Click"
                            Background="Transparent" BorderBrush="#FFD1D5DB" Foreground="#FF374151" />
                    <Button x:Name="ModeButton" Content="Edit" Click="ModeButton_Click"
                            Background="Transparent" BorderBrush="#FFD1D5DB" Foreground="#FF374151" />
                    <Button x:Name="SaveButton" Content="Save" Click="SaveButton_Click"
                            Background="Transparent" BorderBrush="#FFD1D5DB" Foreground="#FF374151" />
                    <Button x:Name="SaveAsButton" Content="Save as…" Click="SaveAsButton_Click"
                            Background="Transparent" BorderBrush="#FFD1D5DB" Foreground="#FF374151" />
                    <ComboBox x:Name="LanguageBox" Width="132" Height="31" Margin="6,0,0,0"
                              VerticalContentAlignment="Center" SelectionChanged="LanguageBox_SelectionChanged" />
                    <Button x:Name="ThemeButton" Content="Dark theme" Click="ThemeButton_Click"
                            Background="Transparent" BorderBrush="#FFD1D5DB" Foreground="#FF374151" />
                    <Button x:Name="OpenButton" Content="Open…" Click="OpenButton_Click"
                            Background="#FF2563EB" BorderBrush="#FF2563EB" Foreground="White" />
                </StackPanel>
            </Grid>
        </Border>

        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Height="28" Background="White"
                BorderBrush="#FFE5E7EB" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Ready" FontSize="11" Foreground="#FF6B7280"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ShortcutText" Text="Ctrl+O — open  ·  F5 — refresh" FontSize="11" Foreground="#FF9CA3AF"
                           Grid.Column="1" Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border x:Name="FormatToolbar" DockPanel.Dock="Top" Height="44" Background="White"
                BorderBrush="#FFE5E7EB" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Margin="18,6">
                    <Button x:Name="BoldButton" Command="EditingCommands.ToggleBold" CommandTarget="{Binding ElementName=Viewer}"
                            Width="38" Padding="0" FontWeight="Bold" Content="B" Click="FormattingButton_Click" />
                    <Button x:Name="ItalicButton" Command="EditingCommands.ToggleItalic" CommandTarget="{Binding ElementName=Viewer}"
                            Width="38" Padding="0" FontStyle="Italic" Content="I" Click="FormattingButton_Click" />
                    <Separator Margin="8,0" />
                    <Button x:Name="Heading1Button" Content="H1" Click="Heading1Button_Click" Width="42" Padding="0" />
                    <Button x:Name="Heading2Button" Content="H2" Click="Heading2Button_Click" Width="42" Padding="0" />
                    <Button x:Name="NormalButton" Content="Text" Click="NormalButton_Click" />
                    <Separator Margin="8,0" />
                    <Button x:Name="AlignLeftButton" Command="EditingCommands.AlignLeft" CommandTarget="{Binding ElementName=Viewer}"
                            Content="≡" Width="38" Padding="0" Click="FormattingButton_Click" />
                    <Button x:Name="AlignCenterButton" Command="EditingCommands.AlignCenter" CommandTarget="{Binding ElementName=Viewer}"
                            Content="≡" Width="38" Padding="0" HorizontalContentAlignment="Center" Click="FormattingButton_Click" />
                    <Button x:Name="AlignRightButton" Command="EditingCommands.AlignRight" CommandTarget="{Binding ElementName=Viewer}"
                            Content="≡" Width="38" Padding="0" HorizontalContentAlignment="Right" Click="FormattingButton_Click" />
                    <Separator Margin="8,0" />
                    <Button x:Name="BulletsButton" Command="EditingCommands.ToggleBullets" CommandTarget="{Binding ElementName=Viewer}"
                            Content="• List" Click="FormattingButton_Click" />
                    <Button x:Name="NumberingButton" Command="EditingCommands.ToggleNumbering" CommandTarget="{Binding ElementName=Viewer}"
                            Content="1. List" Click="FormattingButton_Click" />
                    <Button x:Name="TableButton" Content="Table 3×3" Click="TableButton_Click" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid>
            <RichTextBox x:Name="Viewer" IsReadOnly="True" IsDocumentEnabled="True" AcceptsTab="True"
                         Background="Transparent" BorderThickness="0" Padding="42,26,42,50"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Visibility="Collapsed" SelectionBrush="#663B82F6" TextChanged="Viewer_TextChanged" />
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                        MaxWidth="430" Margin="30">
                <TextBlock Text="MD" FontFamily="Segoe UI Light" FontSize="54" Foreground="#FF2563EB"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="EmptyTitle" Text="Simple Markdown viewing" FontFamily="Segoe UI Semibold" FontSize="22"
                           Foreground="#FF111827" HorizontalAlignment="Center" Margin="0,12,0,7" />
                <TextBlock x:Name="EmptySubtitle" Text="Drop an .md file into this window or select “Open…”."
                           FontSize="14" Foreground="#FF6B7280" TextAlignment="Center" TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
